# Copier en .env à la racine de alicia_coach (ne pas committer .env)

# Lien public Calendly (event type ou page d’accueil scheduling)
# Ex. https://calendly.com/votre-compte/30min
VITE_CALENDLY_URL=

# Formulaire Tally (témoignages) — lien public du form
# Ex. https://tally.so/r/xxxxxxxx
VITE_TALLY_URL=

# MongoDB (scripts / API uniquement — pas de préfixe VITE_)
MONGODB_URI=
MONGODB_DB_NAME=alicia_coach

# Dev local si erreur « unable to verify the first certificate » (antivirus / proxy)
# Ne jamais activer en production. Voir INSTRUCTION.md (SSL).
MONGODB_TLS_INSECURE=true
