# Copier en .env à la racine de alicia_coach (ne pas committer .env)

# --- Front (préfixe VITE_ = exposé au navigateur) ---

# Calendly — lien public du type de rendez-vous
# Ex. https://calendly.com/votre-compte/30min
VITE_CALENDLY_URL=

# Tally — formulaire collecte témoignages (pas le contact)
# Ex. https://tally.so/r/xxxxxxxx
VITE_TALLY_URL=

# Email affiché sur le site (optionnel)
# VITE_CONTACT_EMAIL=contact@example.com

# --- Serveur uniquement (NE PAS préfixer VITE_) ---
# Utilisées par server/dev-api.mjs, api/contact.js (Vercel), et en prod dans le dashboard Vercel

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_NAME=alicia_coach

# Dev local uniquement si erreur certificat TLS (antivirus / proxy). Jamais en prod.
# MONGODB_TLS_INSECURE=true

# Port API Express en local (défaut 3001 — doit correspondre au proxy vite.config.js)
CONTACT_API_PORT=3001

# --- À venir (étape email) ---
# RESEND_API_KEY=
# CONTACT_NOTIFY_TO=alicia@example.com
# CONTACT_NOTIFY_FROM=contact@ton-domaine.com

# Porte preview (exposé au navigateur via envPrefix SITE_ dans vite.config.js)
# SITE_PASSWORD=

# --- Stripe (serveur + price IDs sur Vercel, jamais VITE_ pour sk_test_) ---
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_SEANCE=
# STRIPE_PRICE_PACK=
# SITE_URL=https://ton-site.vercel.app
# STRIPE_PUBLISHABLE_KEY=
